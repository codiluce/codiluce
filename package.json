{
  "name": "codiluce",
  "description": "Bring your code to light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite --import tsx src/cli.ts start",
    "codiluce": "node --experimental-sqlite --import tsx src/cli.ts",
    "dev:web": "next dev web --port 4310",
    "build:web": "next build web",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts web/tests/*.test.ts",
    "test:e2e": "next build web && playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build": "tsc && next build web"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "highlight.js": "^11.12.0",
    "next": "^16.3.8",
    "php-parser": "^3.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.0"
  }
}
