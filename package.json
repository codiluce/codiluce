{
  "name": "archipelago",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "archipelago": "node --experimental-sqlite --import tsx src/cli.ts",
    "dev:web": "next dev web --port 4310",
    "build:web": "next build web",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts web/tests/*.test.ts",
    "test:e2e": "next build web && playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build": "tsc && next build web"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "next": "^16.3.8",
    "php-parser": "^3.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.0"
  }
}
