{
  "name": "codiluce",
  "description": "See how your code fits together: a zoomable, evidenced map of your repository with every flow, its Git history and blast radius, and explanations from your coding agent over MCP.",
  "keywords": [
    "code-map",
    "codebase",
    "architecture",
    "visualization",
    "static-analysis",
    "call-graph",
    "git-history",
    "blast-radius",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "developer-tools",
    "typescript",
    "javascript",
    "python",
    "php",
    "java",
    "go",
    "rust",
    "react",
    "nextjs",
    "laravel",
    "django",
    "spring",
    "rails"
  ],
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codiluce/codiluce.git"
  },
  "homepage": "https://codiluce.com",
  "bugs": "https://github.com/codiluce/codiluce/issues",
  "type": "module",
  "bin": {
    "codiluce": "bin/codiluce.js"
  },
  "files": [
    "bin/codiluce.js",
    "dist/src/",
    "dist/grammars/",
    "web/out/",
    "docs/architecture-visualizer.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite --import tsx src/cli.ts start",
    "codiluce": "node --experimental-sqlite --import tsx src/cli.ts",
    "dev:web": "next dev web --port 4310",
    "build:web": "next build web && node scripts/copy-ui-licenses.mjs",
    "test": "node --experimental-sqlite --import tsx --test --test-concurrency=4 tests/*.test.ts web/tests/*.test.ts",
    "test:e2e": "next build web && playwright test",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build:cli": "node scripts/build-cli.mjs",
    "build:script-worker": "node scripts/build-script-worker.mjs",
    "build:framework-worker": "node scripts/build-framework-worker.mjs",
    "grammars:sync": "node scripts/sync-grammars.mjs",
    "build": "npm run build:cli && npm run build:web",
    "prepack": "npm run build",
    "build:native-worker": "node scripts/build-native-worker.mjs",
    "prototype:visual": "next dev web --port 4390"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@astrojs/compiler-rs": "0.5.1",
    "ignore": "^7.0.12",
    "php-parser": "^3.7.0",
    "semver": "7.8.5",
    "smol-toml": "^1.9.0",
    "svelte": "5.57.2",
    "typescript": "^5.9.3",
    "web-tree-sitter": "0.27.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "esbuild": "0.28.2",
    "highlight.js": "^11.12.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-embedded-template": "0.25.0",
    "tree-sitter-html": "0.23.2",
    "tree-sitter-objc": "3.0.2",
    "tsx": "^4.20.0"
  }
}
